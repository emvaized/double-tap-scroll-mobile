{
    "manifest_version": 3,
    "name": "Double Tap Scrolling",
    "version": "1.0.9",
    "description": "Scroll page when double tap on empty space (mobile)",
    "author": "emvaized",
    "browser_specific_settings": {
      "gecko": {
        "id": "double_tab_scroll_mobile@emvaized.dev",
        "data_collection_permissions": {
          "required": ["none"]
        }
      },
      "gecko_android": {
        "id": "double_tab_scroll_mobile@emvaized.dev",
        "data_collection_permissions": {
          "required": ["none"]
        }
      }
    },
    "icons": {
        "48": "icon.svg"
    },
    "options_ui": {
        "page": "options/options.html"
    },
    "action": {
        "default_popup": "options/options.html",
        "default_icon": {
            "48": "icon.svg"
        }
    },
    "permissions": [
        "storage"
    ],
    "content_scripts": [
      {
        "matches": [
          "<all_urls>"
        ],
        "js": [
          "double_tap_scroll.js"
        ],
        "run_at": "document_start"
      }
    ]
}